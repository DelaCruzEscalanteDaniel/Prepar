# Copia este archivo como .env y llena tus datos. El archivo .env NUNCA se sube a GitHub.

# --- Servidor ---
PORT=3000
# production en Render (activa la cookie segura)
NODE_ENV=development
# Dirección pública, sin diagonal al final (se usa en los enlaces de los correos)
# URL_PUBLICA=https://tu-servicio.onrender.com

# --- Base de datos MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prepar
# true si el proveedor exige SSL (Aiven)
DB_SSL=false
# Certificado de Aiven ("CA certificate"): ruta al archivo ca.pem o el texto completo
DB_SSL_CA=

# --- Correo con la API de Brevo (para recuperar contraseña y avisar a funcionarios nuevos) ---
CORREO_API_KEY=
# Ejemplo: Prepar <equipoprepar@gmail.com>
CORREO_REMITENTE=

# --- Administrador para otro equipo (opcional) ---
# Si llenas los dos, al arrancar se crea "Administrador de pruebas". Deja la contraseña vacía para desactivarlo.
ADMIN_PRUEBAS_CORREO=
ADMIN_PRUEBAS_PASSWORD=
