# Copia este archivo como .env y llena tus datos. El archivo .env NUNCA se sube a GitHub.

# --- Servidor ---
PORT=3000
# production en Render (activa cookies seguras y confía en el proxy)
NODE_ENV=development
# URL pública, sin diagonal final (enlaces de los correos). Si no se indica: http://localhost:PORT
# URL_PUBLICA=https://tu-servicio.onrender.com

# --- Base de datos MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prepar
# Conexiones simultáneas a MySQL (bájalo si tu proveedor gratuito permite pocas)
DB_CONEXIONES=10
# true si tu proveedor de MySQL exige SSL (Aiven, PlanetScale, TiDB, etc.)
DB_SSL=false
# false solo si el certificado del proveedor no es verificable
DB_SSL_VERIFICAR=true
# Opcional: socket local en lugar de host/puerto
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- Correo (opcional). Sin esto los correos quedan en la cola sin enviarse ---
# Opción recomendada: una cuenta de Gmail con "contraseña de aplicación"
#   1) Activa la verificación en dos pasos: https://myaccount.google.com/security
#   2) Crea la contraseña de aplicación:    https://myaccount.google.com/apppasswords
#   3) Llena estas líneas (la contraseña es la de 16 letras, NO la normal de Gmail)
CORREO_PROVEEDOR=
CORREO_SMTP_USUARIO=
CORREO_SMTP_CONTRASENA=
CORREO_REMITENTE=
# Ejemplo:
# CORREO_PROVEEDOR=gmail
# CORREO_SMTP_USUARIO=equipo@gmail.com
# CORREO_SMTP_CONTRASENA=abcdefghijklmnop
# CORREO_REMITENTE=Prepar <equipo@gmail.com>
#
# Otro servidor SMTP: CORREO_PROVEEDOR=smtp y además
# CORREO_SMTP_HOST=smtp.tu-servidor.com
# CORREO_SMTP_PUERTO=465        (465 con TLS o 587 con STARTTLS)
#
# Por API: CORREO_PROVEEDOR=resend o brevo, con CORREO_API_KEY y CORREO_REMITENTE
# CORREO_API_KEY=

# --- Inicio de sesión con Google (opcional) ---
# Crea un "ID de cliente de OAuth" tipo "Aplicación web" en https://console.cloud.google.com/apis/credentials
# URI de redireccionamiento autorizado: <URL_PUBLICA>/api/auth/google/callback
#   (en tu computadora: http://localhost:3000/api/auth/google/callback)
# Si se dejan vacías, el botón de Google muestra que no está activado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Texto largo al azar para firmar las cookies temporales de Google (si falta, se genera uno al arrancar)
SECRETO_FIRMAS=

# --- CAPTCHA ---
# Código en imagen al crear cuenta, al recuperar contraseña y tras 2 intentos fallidos de inicio de sesión
CAPTCHA=true

# --- Procesos ---
# Envío de correos (cada minuto) y sincronización con datos abiertos (cada 10 min)
TAREAS_PROGRAMADAS=true
# Ubicar direcciones con Nominatim (OpenStreetMap)
GEOCODIFICACION=true
# true para no escribir avisos en la consola
LOG_SILENCIO=false

# --- Avanzado ---
# COOKIE_SEGURA=true      # por defecto true en producción
# CONFIAR_PROXY=1         # por defecto 1 en producción
# LIMITES_FACTOR=1        # multiplica los límites anti-abuso (solo para pruebas de carga)
