# Copia este archivo como .env y llena tus datos. El archivo .env NUNCA se sube a GitHub.

# --- Servidor ---
PORT=3000
# production en Render (activa cookies seguras y confía en el proxy)
NODE_ENV=development
# URL pública, sin diagonal final (enlaces de los correos). Si no se indica: http://localhost:PORT
# URL_PUBLICA=https://tu-servicio.onrender.com

# --- Base de datos MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prepar
# Conexiones simultáneas a MySQL (bájalo si tu proveedor gratuito permite pocas)
DB_CONEXIONES=10
# true si tu proveedor de MySQL exige SSL (Aiven, PlanetScale, TiDB, etc.)
DB_SSL=false
# false solo si el certificado del proveedor no es verificable
DB_SSL_VERIFICAR=true
# Certificado de la autoridad del proveedor (Aiven lo da como "CA certificate"): ruta al archivo (p. ej. ca.pem)
# o el texto completo del certificado (en Render se puede pegar tal cual)
DB_SSL_CA=
# Opcional: socket local en lugar de host/puerto
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- Correo con la API de Brevo (opcional). Sin esto los correos quedan en la cola sin enviarse ---
#   1) Crea una cuenta gratuita en https://www.brevo.com y verifica el correo que usarás como remitente
#   2) En Brevo: SMTP & API > API Keys > Generate a new API key
#   3) Pega aquí la clave y el remitente verificado
CORREO_API_KEY=
CORREO_REMITENTE=
# Ejemplo:
# CORREO_REMITENTE=Prepar <equipoprepar@gmail.com>

# --- Cuenta de administrador para otro equipo (opcional) ---
# Si se llenan las dos, al arrancar se crea (o reactiva) un segundo administrador: "Administrador de pruebas".
# Para quitarle el acceso, deja ADMIN_PRUEBAS_PASSWORD vacía y reinicia: la cuenta se desactiva.
ADMIN_PRUEBAS_CORREO=
ADMIN_PRUEBAS_PASSWORD=

# Verificación del sitio en Google Search Console (método "Archivo HTML"): pega aquí el nombre del archivo, p. ej. google1a2b3c4d5e6f7a8b.html
GOOGLE_VERIFICACION=

# --- Verificación de correo ---
# Los ciudadanos confirman su correo con un enlace antes de publicar, registrar proyectos o votar.
# Por defecto (vacía) se exige solo cuando hay un proveedor de correo configurado; true la exige siempre y false la apaga.
VERIFICAR_CORREO=

# --- Procesos ---
# Envío de correos (cada minuto) y sincronización con datos abiertos (cada 10 min)
TAREAS_PROGRAMADAS=true
# Ubicar direcciones con Nominatim (OpenStreetMap)
GEOCODIFICACION=true
# true para no escribir avisos en la consola
LOG_SILENCIO=false

# --- Avanzado ---
# COOKIE_SEGURA=true      # por defecto true en producción
# CONFIAR_PROXY=1         # por defecto 1 en producción
# LIMITES_FACTOR=1        # multiplica los límites anti-abuso (solo para pruebas de carga)
